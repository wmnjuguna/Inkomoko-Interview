+<?xml version="1.0" encoding="UTF-8"?>
+<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
+                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
+    <!-- One row per ERP-synced GL account: the ERP reference, the GL account it created, and the hash of that payload. -->
+    <changeSet author="inkomoko" id="glsync-0001-external-ref">
+        <createTable tableName="glsync_external_ref">
+            <column name="id" type="BIGINT" autoIncrement="true">
+                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_glsync_external_ref"/>
+            </column>
+            <column name="gl_account_id" type="BIGINT">
+                <constraints nullable="false" unique="true" uniqueConstraintName="uq_glsync_external_ref_gl_account"
+                             foreignKeyName="fk_glsync_external_ref_gl_account" references="acc_gl_account(id)"/>
+            </column>
+            <column name="external_reference" type="VARCHAR(100)">
+                <constraints nullable="false" unique="true" uniqueConstraintName="uq_glsync_external_ref_reference"/>
+            </column>
+            <column name="payload_hash" type="CHAR(64)">
+                <constraints nullable="false"/>
+            </column>
+            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
+                <constraints nullable="false"/>
+            </column>
+        </createTable>
+    </changeSet>
+</databaseChangeLog>
