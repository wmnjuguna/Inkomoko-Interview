+        assertThat(ErpAccountCommands.erpReferenceFrom(command.getHref())).isEqualTo("GL-1200");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = { "GL-1200", "1100", "acct.4000_v2", "ERP:GL:1200" })
+    @DisplayName("accepts references made of letters, digits and . _ : -")
