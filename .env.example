# Local development values only. Copy to .env: cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

FINERACT_DB_USER=fineract
FINERACT_DB_PASSWORD=change-me-fineract
FINERACT_MASTER_PASSWORD=change-me-master

INTEGRATION_DB_USER=integration
INTEGRATION_DB_PASSWORD=change-me-integration
PARTNER_API_KEYS=demo-partner:change-me-partner-key
INTEGRATION_LOG_LEVEL=INFO
INTEGRATION_FINERACT_TIMEOUT_SECONDS=30
# Least-privilege Fineract API user the Integration Service logs in as (made by setup).
# The password must pass Fineract's policy: 12-50 chars, upper, lower, digit, symbol, no repeats.
FINERACT_API_USERNAME=integration-api
FINERACT_API_PASSWORD=Change-Me-Fineract-Api-1

ERP_DB_USER=erp
ERP_DB_PASSWORD=change-me-erp
ERP_API_KEY=change-me-erp-key
ERP_LOG_LEVEL=INFO
ERP_TIMEOUT_DELAY=10

# Fineract's built-in admin, used only by the setup script
FINERACT_ADMIN_USER=mifos
FINERACT_ADMIN_PASSWORD=password
